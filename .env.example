# Copy this file and fill in your values:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real secrets.
#
# Minimum viable setup: fill in every key in the REQUIRED section.
# Everything in OPTIONAL has either a sensible default or unlocks a specific feature.

# ═════════════════════════════════════════════════════════════
# REQUIRED
# ═════════════════════════════════════════════════════════════

# Base URL that Docker containers use to call back to the dashboard API.
# Containers POST status updates, questions, and diffs to this URL.
# On macOS Docker Desktop, host.docker.internal resolves to the host machine.
# No default. The dashboard will refuse to start tasks without this.
DASHBOARD_URL=http://host.docker.internal:3001

# Long-lived OAuth token for headless Claude Code sessions inside containers.
# Generate with: claude setup-token
# Format: sk-ant-oat01-...
CLAUDE_CODE_OAUTH_TOKEN=

# Personal access token with repo scope. Used for GraphQL queries
# (PRs, reviews, CI status) and passed to containers for git clone.
# Format: ghp_... or gho_...
GITHUB_TOKEN=

# GitHub username — used in GraphQL search queries (e.g. author:@you, review-requested:@you).
# Example: your-github-handle
GITHUB_USERNAME=

# API key for the dashboard's AI briefing and chat features.
# Get from: console.anthropic.com
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# GitHub repo in org/repo format. Passed to containers for cloning
# and used to construct PR links.
# Example: your-org/your-repo
REPO_URL=

# ═════════════════════════════════════════════════════════════
# OPTIONAL
# ═════════════════════════════════════════════════════════════

# ─── GitHub webhooks & PR reaction pipeline ─────────────
# Shared secret for GitHub webhooks. Generate with: openssl rand -hex 32
# Paste the same value into the repository's webhook settings under "Secret".
# When unset, POST /api/webhooks/github returns 500. The 2-min poll fallback
# keeps working regardless of webhook state.
GITHUB_WEBHOOK_SECRET=

# Comma-separated bot logins whose comments and reviews must NEVER trigger
# the PR reaction pipeline (fix-ci / address-comments dispatches).
# Defaults to "dependabot[bot],renovate[bot]".
IGNORED_BOT_LOGINS=

# Comma-separated bot logins whose PR reviews trigger a bot pre-review pass
# (a validity-check triage dispatch), e.g. an AI code-review bot. These should
# ALSO stay in IGNORED_BOT_LOGINS so they never count as human comments.
# Unset = no bot pre-review.
REVIEW_BOT_LOGINS=

# Comma-separated PR labels that pause the PR reaction pipeline.
# When any of these labels is attached to a PR, the poll cycle records a
# skip reason in pr_state_json but does not dispatch fix-ci or
# address-comments. The `ci-external` label is a convention used by
# investigate-ci agents to signal "CI failure is not PR-caused."
# Defaults to "on-hold,do-not-merge,blocked,ci-external".
ON_HOLD_LABELS=

# Background dashboard context refresh cadence in ms (0 disables; default 120000)
CONTEXT_REFRESH_INTERVAL_MS=120000

# Days to keep logs of finished tasks before pruning (0 disables pruning)
LOG_RETENTION_DAYS=30

# ─── Client-side links (browser) ─────────────────────────────
# NEXT_PUBLIC_ vars are exposed to client-side React. Used for constructing
# links to GitHub/Linear in the browser. Without these, links degrade to
# placeholders like "unknown/repo".
# Example: your-org/your-repo
NEXT_PUBLIC_REPO_URL=
# Example: your-linear-slug
NEXT_PUBLIC_LINEAR_ORG_SLUG=

# Linear org slug — used server-side for URL construction in API routes.
# Example: your-linear-slug
LINEAR_ORG_SLUG=

# ─── Linear ──────────────────────────────────────────────────
# API key for fetching tickets, cycles, and work documents.
# Get from: Linear > Settings > API keys. If unset, Linear data is skipped.
# Format: lin_api_...
LINEAR_API_KEY=

# ─── Local repo ──────────────────────────────────────────────
# Local path to the repo on your machine. Used as a reference cache for fast
# git clones. Containers clone from remote without it.
# Example: /Users/you/Code/your-org/your-repo
REPO_PATH=

# ─── Figma ───────────────────────────────────────────────────
# Personal access token for Figma API. Enables Figma MCP in containers.
# Get from: Figma > Account Settings > Security > Personal Access Tokens
# Scopes needed: file_read, dev_resources
# Format: figd_...
# If unset, Figma MCP is skipped.
FIGMA_API_KEY=

# ─── Database ────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to ./data/dashboard.db
# (relative to the dashboard/ directory).
DATABASE_PATH=

# ─── Docker / agent containers ───────────────────────────────
# Docker image for agent containers. Override to use a custom image.
# Defaults to agent-worker:local (see README: Build the agent image)
AGENT_IMAGE=

# Path to skills directory — mounted into containers at runtime.
# Skills are loaded dynamically — editing a skill file takes effect on next task dispatch.
# Defaults to ../.claude/skills (relative to dashboard/)
SKILLS_PATH=

# Minimum free host disk (GB) required before a container is dispatched.
# A full disk hangs the Docker daemon instead of erroring, so dispatch fails
# fast instead. Defaults to 10; set 0 to disable.
AGENT_MIN_FREE_DISK_GB=

# Filesystem path the disk check measures. Defaults to /
AGENT_DISK_CHECK_PATH=

# Memory limit per agent container, in GB. Defaults to 8.
AGENT_MEMORY_GB=

# Docker volume holding task workspaces and the shared pnpm store. Defaults to
# agent-work; give each dashboard its own if you run more than one on a host.
AGENT_WORK_VOLUME=

# Comma-separated "marketplace:plugin" pairs installed at container startup.
# Format: "github-org/marketplace-repo:plugin-name,..."
# Example: anthropics/claude-plugins-official:superpowers,anthropics/claude-plugins-official:code-simplifier
# NOTE: Do NOT add the figma plugin here — it requires OAuth which doesn't work headless.
# Figma MCP is handled via FIGMA_API_KEY + figma-developer-mcp in the entrypoint.
# If unset, containers start with no plugins.
AGENT_PLUGINS=

# ─── Per-mode model selection ───
# The container picks the Claude model from the task's primary tag (MODE).
# Defaults: housekeeping=haiku; plan/review/ship=opus; everything else=sonnet.
# Accepts aliases (haiku/sonnet/opus, resolve to the installed latest tier) or
# full model IDs. All optional — leave unset to use the defaults above.
#
# AGENT_MODEL — force a single model for ALL tasks (overrides everything below).
AGENT_MODEL=
# AGENT_MODEL_DEFAULT — model for every mode except the ones overridden below.
AGENT_MODEL_DEFAULT=
# AGENT_MODEL_HOUSEKEEPING — model for housekeeping tasks (default: haiku).
AGENT_MODEL_HOUSEKEEPING=
# AGENT_MODEL_PLAN — model for planning tasks (default: opus).
AGENT_MODEL_PLAN=
# AGENT_MODEL_REVIEW — model for PR review tasks (default: opus).
AGENT_MODEL_REVIEW=
# AGENT_MODEL_SHIP — model for ship tasks (default: opus).
AGENT_MODEL_SHIP=
